{
  "name": "dsh-app-launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "description": "本地授权：按 CPU / GPU / 内存空闲情况授权并启动本地 AI 软件与脚本（ComfyUI / LM Studio / NInfer / 任意程序）；配置一次后 Agent 无需二次授权。",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "verify": "node test/verify.mjs && node test/scopes.mjs && node test/workspace-scope.mjs && node test/lazy.mjs && node test/facade.mjs && node test/render.mjs",
    "verify:logic": "node test/verify.mjs",
    "verify:scopes": "node test/scopes.mjs",
    "verify:workspace": "node test/workspace-scope.mjs",
    "verify:lazy": "node test/lazy.mjs",
    "verify:facade": "node test/facade.mjs",
    "verify:render": "node test/render.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
